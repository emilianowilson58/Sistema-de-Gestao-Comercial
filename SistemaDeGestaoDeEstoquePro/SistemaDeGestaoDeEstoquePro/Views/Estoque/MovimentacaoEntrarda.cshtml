        </nav>
        <!-- End of Topbar -->
        <!-- Botao de cadastro de produtos -->
        <div class="d-sm-flex align-items-center justify-content-between ml-4 mb-4">
            <div style="color: black">
                <h1 class="h3 mb-0" style="color: black; font-weight: normal"><i class="fas fa-box-open mr-2 text-primary"></i>  Movimentação de Estoque - Entradas</h1>
                <h6 class="text-gray-800">Visualize o histórico de todas as entradas de produtos no estoque.</h6>
            </div>

        </div>

        <!-- inputs de filtro do estoque-->
        <form class="mb-5 bg-light">
            <div class="row p-2 mb-4 border-left-primary bg-white ml-4 rounded-start-3 align-content-center shadow-sm mr-4">
                <div class="col-xl-4 col-lg-4 col-md-2 p-2">
                    <div>
                        <label class="mb-2" style="color: black">Buscar Produto</label>
                    </div>
                    <div>
                        <input type="text" class="form-control bg-light border-1" placeholder="Pesquisar por nome, código ou Fornecedor...">
                    </div>
                </div>

                <div class="col-xl-3 col-lg-2  col-md-2 p-2">
                    <div>
                        <label class="mb-2" style="color: black">Categoria</label>
                    </div>
                    <div class="input-group">
                        <select class=" bg-light border-1 p-1 w-100 form-select" style="border-radius: 5px; height: 37px; border: 1px solid silver; cursor: pointer;">
                            <option value="todos">Todas Categotia</option>
                            <option value="Em estoque">Rede</option>
                            <option value="Estoque baixo">Computador</option>
                            <option value="Esgotado">Tv</option>
                        </select>
                    </div>

                </div>

                <div class="col-xl-2 col-lg-2  col-md-2 p-2">

                    <div>
                        <label class=" mb-2" style="color: black">Fornecedor</label>
                    </div>
                    <div class="input-group">
                        <select class=" bg-light p-1 w-100" style="border-radius: 5px; height: 37px; border: 1px solid silver; cursor: pointer;">
                            <option value="todos">Todos Fornecedor</option>
                            <option value="Em estoque">Em estoque</option>
                            <option value="Estoque baixo">Estoque baixo</option>
                            <option value="Esgotado">Esgotado</option>
                        </select>
                    </div>

                </div>

                <div class="col-xl-2 col-lg-2  col-md-2 p-2">

                    <div>
                        <label class=" mb-2" style="color: black">Periodo</label>
                    </div>
                    <div class="input-group">
                        <input type="date" name="name" class=" bg-light p-1 w-100" style="border-radius: 5px; height: 37px; border: 1px solid silver; cursor: pointer;" />
                    </div>

                </div>

                <div class="col-xl-2 col-lg-2 col-md-2 p-2">
                    <div>
                        <label class="fw-bold text-dark mb-2"></label>
                    </div>
                    <div class="input-group mt-2">
                        <span type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-filter"></i>
                            Filtar
                        </span>
                    </div>
                </div>
            </div>

        </form>

        <!-- Estatu de vendas -->
        <div class="container-fluid">

            <!-- Cartões de status do estoque-->
            <div class="row">
                <!-- Quantidade de Produtos -->
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-primary shadow h-100">
                        <div class="col-auto p-2">
                            <i class="fas fa-boxes fa-2x text-primary"></i>
                        </div>
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                        <h6>Total de Entrada</h6>
                                    </div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800"><h3>-</h3></div>
                                    <div>
                                        <p class="text-gray-800">Movimentações no periodo</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Unidade em estoque -->
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-success shadow h-100 py-2">
                        <div class="col-auto p2">
                            <i class="fas fa-box fa-2x text-success"></i>
                        </div>
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                        <h6>Unidade em estoque</h6>
                                    </div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800"><h3>-</h3></div>
                                    <div>
                                        <p class="text-gray-800">Unidades recebidas</p>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- Estoque Baixo -->
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-info shadow h-100 py-2">
                        <div class="col-auto">
                            <i class="fas fa-money-bill-wave fa-2x text-info"></i>
                        </div>
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                        <h6>Valores Total</h6>
                                    </div>
                                    <div class="row no-gutters align-items-center">
                                        <div class="col-auto">
                                            <div class="h5 mb-0 mr-3 font-weight-bold text-gray-800">
                                                <h3>-</h3>
                                            </div>
                                            <div>
                                                <p class="text-gray-800">Valores das entradas</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Produto Esgotado -->
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-warning shadow h-100 py-2">
                        <div class="col-auto">
                            <i class="fas fa-truck fa-2x text-warning"></i>
                        </div>
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                        <h6>Fornecedores</h6>
                                    </div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">
                                        <h3>-</h3>
                                    </div>
                                    <div>
                                        <p class="text-gray-800">Fornecedores distintos</p>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row p-2">

                <!-- Content Column -->
                <div class="col-xl-12 col-lg-9 col-md-12 mb-4 bg-light">
                    <div class="card h-100">
                        <div>
                            <div class="card-header py-3 d-flex align-items-center justify-content-between gap-3">
                               <div>
                                    <h6 class="m-0 font-weight-bold text-primary ml-1">
                                    Lista de Entradas</h6>
                               </div>
                               <div>
                                   <a asp-action="" asp-controller="">
                                       <i class=""></i>
                                       Exportar Relatório
                                   </a>
                               </div>
                            </div>
                        </div>

                        <div class="card-body text-center p-3">
                            @* Tabela dos produtos em estoque baixo *@
                            <span>Lista está vázia</span>
                        </div>

                    </div>

                </div>
            </div>
            
        </div>
        <!-- /.container-fluid -->

    </div>
    <!-- End of Main Content -->

</div>
<!-- End of Content Wrapper -->

